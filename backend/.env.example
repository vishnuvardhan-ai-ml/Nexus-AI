# NEXUS AI Backend Environment Configuration Template
PROJECT_NAME="NEXUS AI - Community Intelligence & Risk Decision Platform"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# Firebase Admin SDK & Cloud Firestore Configuration
# Option 1: Local file (for local development)
FIREBASE_PROJECT_ID=nexus-ai-4a631
FIREBASE_SERVICE_ACCOUNT_PATH=backend/secrets/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=nexus-ai-4a631.firebasestorage.app

# Option 2: Google Application Default Credentials (for Google Cloud Run)
# FIREBASE_USE_ADC=true

# Option 3: Raw JSON string environment variable (for Render / Railway)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Distributed Rate Limiting (Optional Redis)
# REDIS_URL=redis://localhost:6379/0
